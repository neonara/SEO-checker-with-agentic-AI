# Copy to .env and fill in. docker compose reads this file both for the
# container's environment and for APP_PORT below.

# --- Required: at least one Groq key (free at https://console.groq.com/keys)
GROQ_API_KEY=
# Several keys, comma-separated, are rotated across one audit. Only helps if
# they belong to separate Groq accounts. Takes precedence over GROQ_API_KEY.
# GROQ_API_KEYS=key1,key2,key3

# --- Optional: raises the rate limit on real Lighthouse audits
# GOOGLE_PAGESPEED_API_KEY=

# --- Web server (docker compose)
# Port published on the host.
# APP_PORT=3003
# Audits one visitor IP may start per hour (0 = no limit).
# SEO_API_RATE_LIMIT_PER_HOUR=5
# Audits allowed to run at the same time, across all visitors.
# SEO_API_MAX_CONCURRENT=2
# Seconds a finished result stays retrievable.
# SEO_API_JOB_TTL_SECONDS=3600
# Only if another site's frontend must call this API (comma-separated origins).
# SEO_API_CORS_ORIGINS=https://example.com
# Refuse to fetch private/loopback addresses. The Docker image sets this to 1;
# leave it on for anything reachable from the internet.
# SEO_AGENT_BLOCK_PRIVATE_HOSTS=1

# --- Optional model / pipeline overrides
# SEO_AGENT_MODEL=llama-3.3-70b-versatile
# SEO_AGENT_PLANNER_MODEL=llama-3.3-70b-versatile
# SEO_AGENT_CRITIC_MODEL=llama-3.3-70b-versatile
# SEO_AGENT_FALLBACK_MODEL=llama-3.1-8b-instant
# SEO_AGENT_COMPETITIVE_MODEL=groq/compound-mini
# SEO_AGENT_MAX_ITER=10
# SEO_AGENT_MAX_REFLECTION_ROUNDS=2
# SEO_AGENT_MAX_WORKERS=2
